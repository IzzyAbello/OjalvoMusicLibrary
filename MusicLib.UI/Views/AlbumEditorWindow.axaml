<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLib.UI.ViewModels"
        x:Class="MusicLib.UI.Views.AlbumEditorWindow"
        x:DataType="vm:AlbumEditorViewModel"
        Title="Editar álbum"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="El cambio aplica a todas las rolas de este álbum."
               Opacity="0.7" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto"
          RowSpacing="8" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Text="Nombre" VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

      <!-- Año: solo enteros de 0 a 9999, sin flechas. -->
      <TextBlock Grid.Row="1" Text="Año" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Year}"
                     PlaceholderText="AAAA"
                     Minimum="0" Maximum="9999" Increment="1"
                     FormatString="0" ParsingNumberStyle="Integer"
                     ShowButtonSpinner="False" />

      <!-- El directorio es parte de la identidad del álbum: no se edita. -->
      <TextBlock Grid.Row="2" Text="Directorio" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Path}"
               IsReadOnly="True" />
    </Grid>

    <!-- Solo se ve si hay un error. -->
    <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"
               IsVisible="{Binding Error,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancelar" Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Content="Guardar" Classes="accent" Command="{Binding SaveCommand}"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
