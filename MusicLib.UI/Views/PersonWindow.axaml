<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLib.UI.ViewModels"
        x:Class="MusicLib.UI.Views.PersonWindow"
        x:DataType="vm:PersonEditorViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="8" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Text="Nombre artístico" VerticalAlignment="Center" />
      <!-- Al editar no se cambia: es el vínculo con su intérprete. -->
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StageName}"
               IsReadOnly="{Binding IsEditing}" />
      <TextBlock Grid.Row="1" Text="Nombre real" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RealName}"
               PlaceholderText="(opcional)" />
      <TextBlock Grid.Row="2" Text="Nacimiento" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BirthDate}"
               PlaceholderText="AAAA-MM-DD (opcional)" />
      <TextBlock Grid.Row="3" Text="Fallecimiento" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeathDate}"
               PlaceholderText="AAAA-MM-DD (opcional)" />
    </Grid>

    <!-- Por qué Guardar está deshabilitado (se actualiza al escribir). -->
    <TextBlock Text="{Binding Problem}" Opacity="0.7" TextWrapping="Wrap"
               IsVisible="{Binding Problem,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Error del núcleo al guardar (por ejemplo, nombre repetido). -->
    <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"
               IsVisible="{Binding Error,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancelar" Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Content="Guardar" Classes="accent" Command="{Binding SaveCommand}"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
