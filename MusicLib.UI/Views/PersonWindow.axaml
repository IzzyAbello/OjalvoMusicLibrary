<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MusicLib.UI.Views.PersonWindow"
        Title="Agregar artista"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="8" ColumnSpacing="8">
      <TextBlock Grid.Row="0" Text="Nombre artístico" VerticalAlignment="Center" />
      <TextBox Grid.Row="0" Grid.Column="1" />
      <TextBlock Grid.Row="1" Text="Nombre real" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" />
      <TextBlock Grid.Row="2" Text="Nacimiento" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" PlaceholderText="AAAA-MM-DD (opcional)" />
      <TextBlock Grid.Row="3" Text="Fallecimiento" VerticalAlignment="Center" />
      <TextBox Grid.Row="3" Grid.Column="1" PlaceholderText="AAAA-MM-DD (opcional)" />
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancelar" Click="OnClose" />
      <Button Content="Agregar" Classes="accent" Click="OnClose" />
    </StackPanel>
  </StackPanel>

</Window>
