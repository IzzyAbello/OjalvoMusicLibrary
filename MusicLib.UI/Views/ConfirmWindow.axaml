<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLib.UI.ViewModels"
        x:Class="MusicLib.UI.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

    <!-- Sin IsDefault: Enter no confirma por accidente algo destructivo. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancelar" Command="{Binding CancelCommand}"
              IsCancel="True" />
      <Button Content="Aceptar" Classes="accent"
              Command="{Binding AcceptCommand}" />
    </StackPanel>
  </StackPanel>

</Window>
