<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MusicLib</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <PackageReference Include="TagLibSharp" Version="2.3.*" />
  </ItemGroup>

  <!-- Los tests ven los tipos internal (DAOs, constructor interno del Controller...). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MusicLib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\rolas.sql" LogicalName="rolas.sql" />
  </ItemGroup>

</Project>